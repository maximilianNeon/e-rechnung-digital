{
  "manifest_version": "0.3",
  "name": "erechnung-digital",
  "display_name": "E-RechnungDigital",
  "version": "0.2.1",
  "description": "Deutsche E-Rechnungen (XRechnung, ZUGFeRD) im Chat erstellen, lesen und prüfen – lokal, ohne Upload.",
  "long_description": "Schreib im Chat einfach, wem du was berechnen willst. Claude erstellt daraus eine E-Rechnung nach EN 16931: XRechnung-XML für Portale und Buchhaltung und ZUGFeRD-PDF für Kunden. Pflichtangaben werden vorher geprüft, Fehlercodes wie BR-DE-15 verständlich erklärt. Deine Firmendaten werden einmal lokal gespeichert, Rechnungen landen im gewählten Ordner. Nichts verlässt deinen Rechner.",
  "author": {
    "name": "NEON Software Solutions GmbH",
    "email": "info@erechnungdigital.com",
    "url": "https://www.erechnungdigital.com"
  },
  "homepage": "https://www.erechnungdigital.com/ki-assistenten",
  "documentation": "https://www.erechnungdigital.com/ki-assistenten",
  "support": "https://www.erechnungdigital.com/impressum",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "ERECHNUNG_OUTPUT_DIR": "${user_config.output_dir}"
      }
    }
  },
  "user_config": {
    "output_dir": {
      "type": "directory",
      "title": "Ordner für Rechnungen",
      "description": "Hier speichert die Erweiterung die erzeugten PDF- und XML-Dateien.",
      "required": true,
      "default": "${DOCUMENTS}/E-Rechnungen"
    }
  },
  "tools": [
    {
      "name": "get_seller_profile",
      "description": "Gespeicherte eigene Firmendaten lesen"
    },
    {
      "name": "save_seller_profile",
      "description": "Eigene Firmendaten lokal speichern"
    },
    {
      "name": "create_invoice",
      "description": "XRechnung-XML und ZUGFeRD-PDF erzeugen"
    },
    {
      "name": "read_invoice",
      "description": "XRechnung oder ZUGFeRD-PDF lesen"
    },
    {
      "name": "check_invoice",
      "description": "E-Rechnung auf Pflichtangaben und Regeln prüfen"
    },
    {
      "name": "explain_rule",
      "description": "Prüfregel wie BR-DE-15 erklären"
    }
  ],
  "keywords": [
    "e-rechnung",
    "xrechnung",
    "zugferd",
    "rechnung",
    "invoice",
    "en16931"
  ],
  "license": "MIT",
  "privacy_policies": [
    "https://www.erechnungdigital.com/datenschutz"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}
