    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7",
    "zugferd-ts": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
